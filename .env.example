# AWS credentials used by the server-side DynamoDB client.
# Never commit real credentials — copy this file to .env.local and fill in values.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Optional: point the SDK at a local DynamoDB instance for development
# (e.g. `docker run -p 8000:8000 amazon/dynamodb-local`).
# Leave unset to talk to real AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000

# Table names (override per environment: dev/staging/prod)
DYNAMODB_TABLE_USERS=verve_users
DYNAMODB_TABLE_PRODUCTS=verve_products
DYNAMODB_TABLE_CATEGORIES=verve_categories
DYNAMODB_TABLE_CART=verve_cart
DYNAMODB_TABLE_WISHLIST=verve_wishlist

# Public app config
NEXT_PUBLIC_APP_NAME="Verve Market"
